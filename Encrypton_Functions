void writePasswordToEEPROM(const char *p){
  for(int i = 0; i < PASS_LENGTH; ++i){
    unsigned char u;
    if((unsigned char)p[i] == '0'){
      u = '1';
    } else if((unsigned char)p[i] == '1'){
      u = '2';
    } else if((unsigned char)p[i] == '2'){
      u = '3';
    } else if((unsigned char)p[i] == '3'){
      u = '4';
    } else if((unsigned char)p[i] == '4'){
      u = '5';
    } else if((unsigned char)p[i] == '5'){
      u = '6';
    } else if((unsigned char)p[i] == '6'){
      u = '7';
    } else if((unsigned char)p[i] == '7'){
      u = '8';
    } else if((unsigned char)p[i] == '8'){
      u = '9';
    } else if((unsigned char)p[i] == '9'){
      u = '0';
    } else u = '0';

    EEPROM_write(ADDR_PASSWORD + i, u);
    stored[i] = u;
  }
  stored[PASS_LENGTH] = '\0';
  writeFlag();
}

void readPasswordFromEEPROM(char *outBuf){
  for(int i = 0; i < PASS_LENGTH; ++i){
    char v = (char)EEPROM_read(ADDR_PASSWORD + i);
    if (v == '0'){
      outBuf[i] = '9';
    } else if(v == '1'){
      outBuf[i] = '0';
    } else if(v == '2'){
      outBuf[i] = '1';
    } else if(v == '3'){
      outBuf[i] = '2';
    } else if(v == '4'){
      outBuf[i] = '3';
    } else if(v == '5'){
      outBuf[i] = '4'; 
    } else if(v == '6'){
      outBuf[i] = '5';
    } else if(v == '7'){
      outBuf[i] = '6';
    } else if(v == '8'){
      outBuf[i] = '7';
    } else if(v == '9'){
      outBuf[i] = '8';
    } else outBuf[i] = '0';
  }
