const int ADDR_FLAG = 0;
const unsigned int ADDR_PASSWORD = 1;
const unsigned int INIT_FLAG = 0xAA;
const int PASS_LENGTH = 4;

char entered[PASS_LENGTH + 1];
char stored[PASS_LENGTH + 1];

bool password = false;
int buzzerPin = 12;
const int servoPin = 10;
const int sensorPin = A1;
const int currentThreshold = 120;

#define IDLE_TIMEOUT_MS 10000UL
volatile uint8_t wokeFromPCINT = 0;
unsigned long lastActivityMs = 0;

//forward declarations
static inline void adc_off(void);
static inline void adc_on(void);
static void enable_pcint_on_A0(void);
static void disable_pcint_on_A0(void);
static void powerdown_until_key(void);
void __attribute__((signal)) PCINT1_vect(void);

//main setup
void setup(){

  //setup buzzer pin
  pinMode(buzzerPin, OUTPUT);
  //setup servo pin
  pinMode(9, OUTPUT);

  //if password has never been set, set one for the first time and save it to memory
  if(!isPasswordSet()){
    //reads and saves password
    readPasswordFromKeypad(entered);
    writePasswordToEEPROM(entered);
    readPasswordFromEEPROM(stored);
    password = false;
    setServoAngle2(-90);  // lock servo initially
    delay(500);
  } else {
    //read stored password
    readPasswordFromEEPROM(stored);
    password = false;
    setServoAngle2(-90);  // lock servo initially
  }

  //idle timer
  lastActivityMs = millis();
}

//main loop
void loop() {
  readPasswordFromKeypad(entered);

  //read password in from keypad and check against stored value
  //if correct -> unlock, if incorrect -> stay locked
  if(comparePasswords(entered, stored)){
    password = true;
    setServoAngle2(90);   // unlock servo
    unlockedMenu();
  } else {
    password = false;
    buzzerPasswordIncorrect();
    setServoAngle2(-90);  // keep locked
    //delay to prevent spam
    delay(500);
  }
  //enter sleep mode if system is locked and idle timeout has passed
  if (!password && (millis() - lastActivityMs >= IDLE_TIMEOUT_MS)) {
    powerdown_until_key();          //powerdown wake on A0
    lastActivityMs = millis();
  }
}

//HELPER FUNCTIONS

//converts resistor ladder voltage to keypad press
char getKeyAnalog() {
  int sensorValue = analogRead(A0);
  if (sensorValue < 400) return 0;

  char key = 0;
  if (sensorValue > 800){
    key = '1';
  } else if (sensorValue > 750){
    key = '2';
  } else if (sensorValue > 700){
    key = '3';
  } else if (sensorValue > 670){
    key = '4';
  } else if (sensorValue > 630){
    key = '5';
  } else if (sensorValue > 580){
    key = '6';
  } else if (sensorValue > 540){
    key = '7';
  } else if (sensorValue > 515){
    key = '8';
  } else if (sensorValue > 480){
    key = '9';
  } else if (sensorValue > 455){
    key = '*';
  } else if (sensorValue > 435){
    key = '0';
  } else if (sensorValue > 421) key = '#';

  if (key != 0) {
    delay(30);
    while (analogRead(A0) > 400) {
      delay(10);
    }
  }
  buzzerButtonPressed();
  return key;
}

//reads 4 keys in from the keypad and stores in buffer
void readPasswordFromKeypad(char *buf) {
  int idx = 0;
  //set the buffer address to receive memory
  memset(buf, 0, PASS_LENGTH + 1);

  while(idx < PASS_LENGTH){
    char k = getKeyAnalog();
    //read in a key press, and only fill the memory if its a number
    if(k){
      if(k >= '0' && k <= '9') {
        buf[idx++] = k;

        //reset idle timer on keypress
        lastActivityMs = millis();
      }
    }
    //prevent spam
    delay(10);
  }
  //null terminate
  buf[PASS_LENGTH] = '\0';
}

//    --EEPROM Helpers--

//check if password is set by checking if INIT_FLAG was set
bool isPasswordSet(){
  return (EEPROM_read(ADDR_FLAG) == INIT_FLAG);
}

//write initialization flag to ADDR_FLAG - used when intializing first-ever password
void writeFlag(){
  EEPROM_write(ADDR_FLAG, INIT_FLAG);
}

//write and encrypt password to EEPROM
void writePasswordToEEPROM(const char *p){
  for(int i = 0; i < PASS_LENGTH; ++i){
    char u;
    if(p[i] == '0'){
      u = '2';
    } else if(p[i] == '1'){
      u = '3';
    } else if(p[i] == '2'){
      u = '0';
    } else if(p[i] == '3'){
      u = '1';
    } else if(p[i] == '4'){
      u = '6';
    } else if(p[i] == '5'){
      u = '8';
    } else if(p[i] == '6'){
      u = '4';
    } else if(p[i] == '7'){
      u = '9';
    } else if(p[i] == '8'){
      u = '5';
    } else if(p[i] == '9'){
      u = '7';
    } else u = '0';

    EEPROM_write(ADDR_PASSWORD + i, (unsigned char)u);
  }
  writeFlag();
}

//read and decrypt password to EEPROM
void readPasswordFromEEPROM(char *outBuf){
  for(int i = 0; i < PASS_LENGTH; ++i){
    char v = (char)EEPROM_read(ADDR_PASSWORD + i);
    if (v == '0'){
      outBuf[i] = '2';
    } else if(v == '1'){
      outBuf[i] = '3';
    } else if(v == '2'){
      outBuf[i] = '0';
    } else if(v == '3'){
      outBuf[i] = '1';
    } else if(v == '4'){
      outBuf[i] = '6';
    } else if(v == '5'){
      outBuf[i] = '8'; 
    } else if(v == '6'){
      outBuf[i] = '4';
    } else if(v == '7'){
      outBuf[i] = '9';
    } else if(v == '8'){
      outBuf[i] = '5';
    } else if(v == '9'){
      outBuf[i] = '7';
    } else outBuf[i] = '0';
  }
  outBuf[PASS_LENGTH] = '\0';
  for(int i = 0; i<=PASS_LENGTH; ++i) stored[i] = outBuf[i];
}

//  --UI Functions--

//compare two passwords and return if they are the same
bool comparePasswords(const char *a, const char *b){
  for(int i = 0; i < PASS_LENGTH; ++i){
    if(a[i] != b[i]) return false;
  }
  return true;
}

//unlocked state handler - change password ('*') or relock system ('#'), idle timeout and relock
void unlockedMenu(){
  buzzerPasswordCorrect();
  unsigned long start = millis();
  const unsigned long waitMs = 15000UL;

  char opt = 0;
  while((millis() - start) < waitMs && opt == 0){
    char k = getKeyAnalog();
    if (k){
      if(k == '*') opt = '*';
      else if(k == '#') opt = '#';
    }
    delay(10);
  }
  //enter 'change password' or 'lock' state
  if(opt == '*'){
    readPasswordFromKeypad(entered);
    writePasswordToEEPROM(entered);
    readPasswordFromEEPROM(stored);
    password = false;
    setServoAngle2(-90);  // relock servo automatically
  } else {
    password = false;
    setServoAngle2(-90);  // relock servo
  }
  buzzerPasswordIncorrect();
}

//    --EEPROM--

//write ucData to uiAddress in EEPROM
void EEPROM_write(unsigned int uiAddress, unsigned char ucData) {
  while (EECR & (1 << EEPE));

  EEAR = uiAddress;
  EEDR = ucData;
  EECR |= (1 << EEMPE);
  EECR |= (1 << EEPE);
}

//read char from uiAddress
unsigned char EEPROM_read(unsigned int uiAddress) {
  while (EECR & (1 << EEPE));
  EEAR = uiAddress;
  EECR |= (1 << EERE);
  return EEDR;
}

int currentServoAngle = -90;

//sets Servo angle based on PWM, checks if Servo is blocked
void setServoAngle2(int targetAngle) {
  while (true) {
    int step = (targetAngle > currentServoAngle) ? 10 : -10;
    while (currentServoAngle != targetAngle) {
      if (abs(targetAngle - currentServoAngle) < abs(step))
        step = targetAngle - currentServoAngle;

      int nextAngle = currentServoAngle + step;
      int pwm = map(nextAngle + 90, 0, 180, 1000, 2000);

      for (int i = 0; i < 5; i++) {
        PORTB |= (1 << 1);
        delayMicroseconds(pwm);
        PORTB &= ~(1 << 1);
        delayMicroseconds(20000 - pwm);
      }

      int sensorValue = analogRead(sensorPin);
      if (sensorValue > currentThreshold) {
        int revertPwm = map(currentServoAngle + 90, 0, 180, 1000, 2000);
        for (int i = 0; i < 10; i++) {
          PORTB |= (1 << 1);
          delayMicroseconds(revertPwm);
          PORTB &= ~(1 << 1);
          delayMicroseconds(20000 - revertPwm);
        }
        delay(3000);
        break;
      }

      currentServoAngle = nextAngle;
    }

    if (currentServoAngle == targetAngle)
      break;
  }
}

//    --Buzzer functions--

//key press
void buzzerButtonPressed() {
  tone(buzzerPin, 440); delay(200); noTone(buzzerPin); delay(100);
}

//correct password
void buzzerPasswordCorrect() {
  tone(buzzerPin, 392); delay(200); noTone(buzzerPin); delay(100);
  tone(buzzerPin, 329); delay(150); noTone(buzzerPin); delay(50);  
  tone(buzzerPin, 261); delay(150); noTone(buzzerPin); delay(50); 
  tone(buzzerPin, 523); delay(150); noTone(buzzerPin); delay(50);
}

//incorrect password
void buzzerPasswordIncorrect() {
  tone(buzzerPin, 392); delay(200); noTone(buzzerPin); delay(100);
  tone(buzzerPin, 349); delay(150); noTone(buzzerPin); delay(50);  
  tone(buzzerPin, 231); delay(150); noTone(buzzerPin); delay(50);
}

//    --SLEEP MODE--

//ADC toggle functions
static inline void adc_off(void){ ADCSRA &= ~(1 << ADEN); }
static inline void adc_on(void) { ADCSRA |=  (1 << ADEN); }

//arm pin-change on A0 (PC0 = PCINT8) with pull-up during sleep
static void enable_pcint_on_A0(void) {
  DDRC  &= ~(1 << DDC0);     // PC0 input
  PORTC |=  (1 << PORTC0);   // pull-up ON while sleeping for clean digital level
  PCIFR  |=  (1 << PCIF1);   // clear old flag
  PCMSK1 |=  (1 << 0);       // unmask PCINT8 (bit 0 of PCMSK1)
  PCICR  |=  (1 << PCIE1);   // enable PCINT[14:8] group
}

//disarm pin-change and restore analog ladder behavior
static void disable_pcint_on_A0(void) {
  PCICR  &= ~(1 << PCIE1);
  PCMSK1 &= ~(1 << 0);
  PCIFR  |=  (1 << PCIF1);
  PORTC &= ~(1 << PORTC0);   // pull-up OFF after wake (restore analog A0)
}

//enter power-down and wake on A0 press
static void powerdown_until_key(void){
  adc_off();
  enable_pcint_on_A0();

  //sleep code: 010 (power-down)
  SMCR = (0<<SM2) | (1<<SM1) | (0<<SM0);
  SMCR |= (1<<SE);

  // // Optional: disable BOD during sleep (extra savings). Timed sequence:
  // __asm__ __volatile__("cli" ::: "memory");
  // MCUCR |= (1<<BODS) | (1<<BODSE);
  // MCUCR = (MCUCR & ~(1<<BODSE)) | (1<<BODS);
  // __asm__ __volatile__("sei" ::: "memory");

  // Sleep (raw instruction)
  __asm__ __volatile__("sleep");

  //wake-up
  SMCR &= ~(1<<SE);
  disable_pcint_on_A0();
  adc_on();
  wokeFromPCINT = 0;
  delay(30);
}

//pin change ISR for PCINT[14:8] (A0..A5 group)
void __attribute__((signal)) PCINT1_vect(void){
  wokeFromPCINT = 1;
}



