int sensorPin = A0;      
int sensorValue = 0;
int threshold = 120;     
int pos = 90;            
int step = 2;            

void setup() {
  Serial.begin(9600);
  pinMode(9, OUTPUT);
}

void writeServo(int angle) {
  int pulseWidth = map(angle, 0, 180, 544, 2400);
  digitalWrite(9, HIGH);
  delayMicroseconds(pulseWidth);
  digitalWrite(9, LOW);
}

void loop() {
  sensorValue = analogRead(sensorPin);
  Serial.print("Sensor Value: ");
  Serial.println(sensorValue);

  if (sensorValue > threshold) step = -step;
  pos += step;
  if (pos >= 180) { pos = 180; step = -2; }
  if (pos <= 0) { pos = 0; step = 2; }

  writeServo(pos);
  delay(8);
}
