void writePasswordToEEPROM(const char *p){
  for(int i = 0; i < PASS_LENGTH; ++i){
    char u;
    if(p[i] == '0'){
      u = '1';
    } else if(p[i] == '1'){
      u = '2';
    } else if(p[i] == '2'){
      u = '3';
    } else if(p[i] == '3'){
      u = '4';
    } else if(p[i] == '4'){
      u = '5';
    } else if(p[i] == '5'){
      u = '6';
    } else if(p[i] == '6'){
      u = '7';
    } else if(p[i] == '7'){
      u = '8';
    } else if(p[i] == '8'){
      u = '9';
    } else if(p[i] == '9'){
      u = '0';
    } else u = '0';

    EEPROM_write(ADDR_PASSWORD + i, (unsigned char)u);
    stored[i] = u;
  }
  stored[PASS_LENGTH] = '\0';
  writeFlag();
}

